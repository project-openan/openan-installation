#
# OpenAN offline installation config.
# Copy to config.env, edit, then run:  scripts/install.sh --config config.env
# Leave a value empty ("") to be prompted interactively.

# --- Cluster -----------------------------------------------------------------
# Target namespace for the OpenAN workload.
K8S_NAMESPACE="openan"

# --- Private registry (in-cluster, deployed by this installer) ---------------
# Set to "true" to deploy an in-cluster registry:2 and push all images to it.
INSTALL_REGISTRY="true"
# Node the registry (and, on fallback storage, postgres) is pinned to.
# Leave empty to use the node where install.sh runs.
REGISTRY_NODE=""
# IP of REGISTRY_NODE reachable by every node (used as <ip>:<nodeport>).
# Leave empty to auto-detect.
REGISTRY_NODE_IP=""
# NodePort exposed by the registry Service.
REGISTRY_NODEPORT="30500"

# --- LoadBalancer (MetalLB) --------------------------------------------------
# Set to "true" to install MetalLB when the cluster is bare-metal.
INSTALL_METALLB="true"
# Routable internal IP range for the MetalLB pool (required when INSTALL_METALLB=true).
# e.g. 192.168.1.200-192.168.1.250
METALLB_POOL=""

# --- Ingress -----------------------------------------------------------------
# Leave empty for IP-based access (http://<LB_IP>/).
INGRESS_HOST=""

# --- Frontend ----------------------------------------------------------------
# Unified web entry: "portal" (openan-portal, default) or "workflow-designer".
FRONTEND_TYPE="portal"
# Required: OC admin account password (portal login). OC seeds its 'admin'
# user from this on first boot and refuses to start over HTTP without it.
# Must meet login complexity requirements (length + character classes).
OC_ADMIN_PASSWORD=""

# --- Transport security ------------------------------------------------------
# Serve registry-center and orchestration-center over HTTPS inside the cluster.
# "true" (default): certificates are generated at install time by
# tool/gen_certs.py (openssl) and stored as Secrets openan-rc-tls /
# openan-oc-tls / openan-ingress-client (plus openan-public-tls when
# INGRESS_HOST is set). The ingress always verifies backend certificates
# (proxy-ssl-verify) against the shared CA.
# Set the three secret names below to use your own pre-created Secrets instead
# (RC/OC: server.cer, server_key.pem, trust.cer, cert_pwd; ingress client:
# tls.crt, tls.key, ca.crt). REGISTRY_CLIENT_SECRET is optional OC->RC client
# material (trust.cer, client.cer, client_key.pem) enabling outbound
# verification; leave empty to have it generated with the shared CA.
HTTPS_ENABLED="true"
# Require client certificates (mTLS) on the registry listener. Only meaningful
# when HTTPS_ENABLED="true"; keep "false" when clients authenticate otherwise
# (kubelet httpGet probes present no client certificate).
HTTPS_VERIFY_CLIENT="false"
RC_TLS_SECRET=""
OC_TLS_SECRET=""
INGRESS_CLIENT_SECRET=""
REGISTRY_CLIENT_SECRET=""

# --- Storage (postgres) ------------------------------------------------------
# auto  : use the cluster default StorageClass if present, else fall back to hostPath
# sc    : force a StorageClass (set STORAGE_CLASS)
# hostpath : force a local PV / hostPath pinned to STORAGE_NODE
STORAGE_MODE="auto"
STORAGE_CLASS=""
STORAGE_SIZE="20Gi"
HOSTPATH="/data/openan-postgres"
# Node used by the hostpath / local-PV fallback. Leave empty = node running install.sh.
STORAGE_NODE=""

# --- Database ----------------------------------------------------------------
# Database backend for registry-center and orchestration-center:
#   mysql (default, bundled mysql:8.4.3) or postgresql (bundled
#   postgres:15-alpine) deploy the in-cluster database.
#   Any other lowercase value (e.g. gauss) is an EXTERNAL database: set
#   DB_HOST and DB_PORT too, and no database workload/storage is deployed.
#   The type reaches the services verbatim (PERSISTENCE_MODE) — verify the
#   service images support it before selecting an external type.
DB_TYPE="mysql"
# Required for external DB_TYPE values only.
DB_HOST=""
DB_PORT=""
# Required, 8+ characters; no default. Seeds the database users and is stored
# only as the Kubernetes Secret openan-db-credentials (referenced by the
# chart via existingSecret, never inlined into the values file).
DB_PASSWORD=""

# --- Application images (build-time pinned, install-time overridable) --------
# Bare image reference WITHOUT registry prefix and WITHOUT arch suffix.
# They are pushed to <REGISTRY_NODE_IP>:<REGISTRY_NODEPORT>/<name>:<tag>.
REGISTRY_CENTER_IMAGE="project-openan/registry-center:v1.0.0"
ORCHESTRATION_CENTER_IMAGE="project-openan/orchestration-center:v1.0.0"
WORKFLOW_DESIGNER_IMAGE="project-openan/workflow-designer:v1.0.0"
# Used when FRONTEND_TYPE=portal.
PORTAL_IMAGE="project-openan/openan-portal:v1.0.0"
# Pinned infrastructure image baked into the bundle (registry-relative path).
POSTGRES_IMAGE="library/postgres:15-alpine"
# Used when DB_TYPE=mysql.
MYSQL_IMAGE="library/mysql:8.4.3"

# --- LLM ---------------------------------------------------------------------
REGISTRY_CHAT_MODEL=""
REGISTRY_CHAT_URL=""
REGISTRY_CHAT_APIKEY=""
ORCH_CHAT_MODEL=""
ORCH_CHAT_URL=""
ORCH_CHAT_APIKEY=""
# Offline installs never validate the LLM by default. Set to "true" to probe it.
LLM_VALIDATE="false"

# --- Registry Center ---------------------------------------------------------
# Validate JWS signatures on AgentCards at registration/query time
# (server.conf signature_validation_enabled). The offline bundle serves plain
# HTTP without client certificates, so unsigned cards are the norm — keep
# "false" unless every registering agent signs its cards.
REGISTRY_SIGNATURE_VALIDATION_ENABLED="false"

# --- Optional demo agents server --------------------------------------------
START_AGENTS_SERVER="false"
