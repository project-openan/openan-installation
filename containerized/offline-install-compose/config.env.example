# Literal KEY=VALUE, not executable shell. Relative paths resolve beside this file.
# Copy this file outside the release input tree. This actual file is sensitive.
#
# QUICK EVALUATION: skip manual setup entirely:
#   sudo scripts/install.sh --eval
#   (auto-generates all secrets, certificates, models.yaml, credential file;
#    uses bundled MySQL, HTTP, portal frontend)
#
# Manual setup: scripts/gen-secrets.sh --interactive (or --eval for random keys)
#              tool/gen-certs.sh (for HTTPS/signing certificates)
PROJECT_NAME=openan
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=8080
PUBLIC_ENABLE_HTTPS=false
PUBLIC_TLS_DIR=./pki/public

# Unified web entry: portal (openan-portal, default) or workflow-designer.
# portal requires the portal image tar in the bundle (deps/image-tags.json).
# Compose images, portal included, are pinned by the bundle manifest
# (deps/image-tags.json), unlike the Kubernetes line's frontend.image values.
FRONTEND_TYPE=portal

# External SQL is the production default. Create two databases/users beforehand.
# For a bundled MySQL: DATABASE_INTERNAL=true, set MYSQL_ROOT_PASSWORD.
# For bundled PostgreSQL: DATABASE_TYPE=postgresql, DATABASE_INTERNAL=true, DB_PORT=5432.
DATABASE_TYPE=mysql
DATABASE_INTERNAL=false
DB_HOST=
DB_PORT=3306
REGISTRY_DB_NAME=registry_center
REGISTRY_DB_USERNAME=registry
REGISTRY_DB_PASSWORD=
ORCH_DB_NAME=orchestration_center
ORCH_DB_USERNAME=orchestration
ORCH_DB_PASSWORD=
# Only used by bundled PostgreSQL (set DB_PORT=5432 or another chosen port).
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Public and backend TLS are independent. false here never disables Bearer auth.
REGISTRY_ENABLE_HTTPS=false
REGISTRY_VERIFY_CLIENT=false
REGISTRY_TLS_DIR=./pki/registry
ORCH_ENABLE_HTTPS=false
ORCH_VERIFY_CLIENT=false
ORCH_TLS_DIR=./pki/orchestration
REGISTRY_HEALTHCHECK_HOST=127.0.0.1
ORCH_HEALTHCHECK_HOST=127.0.0.1
BACKEND_VERIFY_SERVER=true
ORCH_CLIENT_VERIFY_SERVER=true
# trust.cer for each verified HTTPS upstream; mTLS also requires client.cer/key.
REGISTRY_PROXY_TLS_DIR=./pki/registry-proxy
ORCH_PROXY_TLS_DIR=./pki/orchestration-proxy
REGISTRY_CLIENT_TLS_DIR=./pki/registry-client

# Signing independent of TLS; true requires sign.cer/sign_key.pem/cert_pwd.
REGISTRY_SIGN_ENABLED=true
REGISTRY_SIGN_DIR=./pki/signing
REGISTRY_PUBLIC_BASE_URL=
REGISTRY_AUTH_MODE=static_bearer
REGISTRY_CREDENTIAL_FILE=./integration_credentials.conf
REGISTRY_MODELS_FILE=./registry-models.yaml
ORCH_MODELS_FILE=./orchestration-models.yaml
REGISTRY_RUNTIME_ENV_FILE=./registry.env
ORCH_RUNTIME_ENV_FILE=./orchestration.env
